# Required for live AI generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol

# Optional: set your real checkout URLs after creating merchant products.
# Keep these as hosted checkout URLs; never put secret payment keys in index.html.
CHECKOUT_CREATOR_URL=
CHECKOUT_PRO_URL=

# Optional branding
SITE_URL=https://your-domain.example
